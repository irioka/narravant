# NARRAVANT 0.1.0 Environment Configuration
LOG_LEVEL=INFO

# Gemini Developer API (Required)
# Note: External API usage incurs costs.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Local Storage and Database
# Relative paths are resolved from the repository root (the directory containing .env).
SQLITE_DB_PATH=./runtime/narravant.sqlite3
LOCAL_STORAGE_PATH=./runtime/storage
